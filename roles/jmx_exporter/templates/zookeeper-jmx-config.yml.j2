---
# JMX Exporter configuration for ZooKeeper
# Based on confluentinc/jmx-monitoring-stacks zookeeper.yml
# Managed by Ansible - do not edit manually

lowercaseOutputName: true
lowercaseOutputLabelNames: true

rules:
  # ZooKeeper service metrics — replicated cluster (ZooKeeper 3.6+)

  # AvgRequestLatency lives on the replica bean but has a different JMX attribute name.
  # Expose it as zookeeper_avglatency to match the dashboard query.
  - pattern: "org.apache.ZooKeeperService<name0=ReplicatedServer_id(\\d+), name1=replica.(\\d+)><>AvgRequestLatency"
    name: zookeeper_avglatency
    labels:
      replicaid: "$1"
      replica: "$2"

  # ZnodeCount lives under the InMemoryDataTree sub-bean.
  # Expose it as zookeeper_znodecount to match the dashboard query.
  - pattern: "org.apache.ZooKeeperService<name0=ReplicatedServer_id(\\d+), name1=replica.(\\d+), name2=InMemoryDataTree><>ZnodeCount"
    name: zookeeper_znodecount
    labels:
      replicaid: "$1"
      replica: "$2"

  # WatchCount also lives on the InMemoryDataTree sub-bean.
  - pattern: "org.apache.ZooKeeperService<name0=ReplicatedServer_id(\\d+), name1=replica.(\\d+), name2=InMemoryDataTree><>WatchCount"
    name: zookeeper_watchcount
    labels:
      replicaid: "$1"
      replica: "$2"

  # NumPendingSyncs lives on the Leader sub-bean only.
  # Expose it as zookeeper_pendingsyncs to match the dashboard query.
  - pattern: "org.apache.ZooKeeperService<name0=ReplicatedServer_id(\\d+), name1=replica.(\\d+), name2=Leader><>NumPendingSyncs"
    name: zookeeper_pendingsyncs
    labels:
      replicaid: "$1"
      replica: "$2"

  # Top-level replicated server attributes (e.g. OutstandingRequests)
  - pattern: "org.apache.ZooKeeperService<name0=ReplicatedServer_id(\\d+)><>(\\w+)"
    name: zookeeper_$2
    labels:
      replicaid: "$1"

  # Replica-level catch-all (NumAliveConnections, MinLatency, MaxLatency, etc.)
  - pattern: "org.apache.ZooKeeperService<name0=ReplicatedServer_id(\\d+), name1=replica.(\\d+)><>(\\w+)"
    name: zookeeper_$3
    labels:
      replicaid: "$1"
      replica: "$2"

  # Leader/Follower/Observer sub-bean catch-all
  - pattern: "org.apache.ZooKeeperService<name0=ReplicatedServer_id(\\d+), name1=replica.(\\d+), name2=(Leader|Follower|Observer)><>(\\w+)"
    name: zookeeper_$4
    labels:
      replicaid: "$1"
      replica: "$2"
      role: "$3"

  # InMemoryDataTree sub-bean catch-all
  - pattern: "org.apache.ZooKeeperService<name0=ReplicatedServer_id(\\d+), name1=replica.(\\d+), name2=InMemoryDataTree><>(\\w+)"
    name: zookeeper_$4
    labels:
      replicaid: "$1"
      replica: "$2"

  # Standalone ZooKeeper (non-replicated)
  - pattern: "org.apache.ZooKeeperService<name0=StandaloneServer_port(\\d+)><>(\\w+)"
    name: zookeeper_$2
    labels:
      port: "$1"

  - pattern: "org.apache.ZooKeeperService<name0=StandaloneServer_port(\\d+), name1=(\\w+)><>(\\w+)"
    name: zookeeper_$3
    labels:
      port: "$1"
      membertype: "$2"

  # JVM memory
  - pattern: java.lang<type=Memory><HeapMemoryUsage>(used|committed|max)
    name: jvm_memory_heap_$1_bytes

  - pattern: java.lang<type=Memory><NonHeapMemoryUsage>(used|committed|max)
    name: jvm_memory_nonheap_$1_bytes

  # JVM GC
  - pattern: java.lang<type=GarbageCollector, name=(.+)><>(CollectionCount|CollectionTime)
    name: jvm_gc_$2_total
    labels:
      gc: "$1"

  # JVM threads
  - pattern: java.lang<type=Threading><>(ThreadCount|DaemonThreadCount|PeakThreadCount)
    name: jvm_threads_$1
